{
  "name": "whatsapp-ai",
  "version": "1.0.0",
  "description": "Enterprise AI Agent Platform for WhatsApp and e-commerce automation",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "start:dev": "NODE_ENV=development node --enable-source-maps server.js",
    "start:worker": "node workers/worker-runner.js",
    "lint": "eslint . --ext .js --max-warnings=0",
    "test": "node --test",
    "ci": "node scripts/auditCompletion.js && node --test",
    "migrate": "node scripts/migrate.js"
  },
  "keywords": [
    "ai",
    "workflow",
    "whatsapp",
    "agent",
    "enterprise"
  ],
  "author": "yadavjj35-web",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "helmet": "^7.0.0",
    "cors": "^2.8.5",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "ioredis": "^5.3.2",
    "bullmq": "^1.87.0",
    "axios": "^1.4.0",
    "uuid": "^9.0.0",
    "stripe": "^11.0.0",
    "razorpay": "^2.8.0",
    "amazon-sp-api": "^5.2.0",
    "@aws-sdk/client-sts": "^3.500.0",
    "@aws-sdk/client-secrets-manager": "^3.500.0",
    "redlock": "^6.0.0",
    "opossum": "^7.0.0",
    "rate-limiter-flexible": "^2.3.2",
    "prom-client": "^14.0.1",
    "winston": "^3.9.0",
    "pino": "^8.13.0",
    "node-fetch": "^3.4.1",
    "redocly": "^2.0.0",
    "opentelemetry-exporter-trace-otlp-http": "^1.11.0",
    "@opentelemetry/sdk-node": "^0.35.0",
    "@opentelemetry/auto-instrumentations-node": "^0.35.0"
  },
  "devDependencies": {
    "eslint": "^8.48.0"
  }
}
