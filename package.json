{
  "name": "ai-whatsapp-sales-assistant",
  "version": "1.0.0",
  "description": "Enterprise AI WhatsApp Sales Assistant - backend (Enterprise-ready)",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon --watch . --ext js,json --signal SIGTERM server.js",
    "test": "mocha --exit \"tests/**/*.test.js\" --reporter spec",
    "lint": "eslint . --ext .js",
    "build": "echo \"No build step required for Node.js backend\"",
    "pm2-start": "pm2 start deployment/pm2.config.js --only whatsapp-ai",
    "format": "prettier --write \"**/*.js\"",
    "check:deps": "node -e \"console.log('Checking deps...')\""
  },
  "keywords": [
    "whatsapp",
    "ai",
    "gemini",
    "woocommerce",
    "amazon-sp-api",
    "n8n",
    "bullmq",
    "redis",
    "qdrant",
    "enterprise",
    "agent",
    "orchestrator"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.5.0",
    "bullmq": "^4.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.8.0",
    "franc": "^6.1.0",
    "helmet": "^7.0.0",
    "ioredis": "^5.3.2",
    "joi": "^17.9.2",
    "jsonwebtoken": "^9.0.2",
    "langs": "^2.0.0",
    "mongoose": "^7.6.0",
    "morgan": "^1.10.0",
    "opossum": "^7.0.6",
    "prom-client": "^14.3.0",
    "qdrant-client": "^1.6.0",
    "qs": "^6.11.0",
    "rate-limiter-flexible": "^2.3.12",
    "redlock": "^6.0.0",
    "redis": "^4.6.5",
    "uuid": "^9.0.0",
    "winston": "^4.10.0",
    "winston-daily-rotate-file": "^4.7.1",
    "@opentelemetry/api": "^1.11.0",
    "@opentelemetry/sdk-node": "^0.41.0",
    "@opentelemetry/auto-instrumentations-node": "^0.41.0",
    "@opentelemetry/instrumentation-http": "^0.41.0",
    "@opentelemetry/instrumentation-express": "^0.41.0",
    "opentelemetry-exporter-trace-otlp-http": "^0.41.0",
    "opentelemetry-exporter-prometheus": "^0.41.0",
    "stripe": "^12.12.0",
    "razorpay": "^2.8.0",
    "@aws-sdk/client-sts": "^3.431.0",
    "@aws-sdk/credential-provider-node": "^3.431.0",
    "@aws-sdk/signature-v4": "^3.431.0",
    "amazon-sp-api": "^3.11.0",
    "redocly": "^2.0.0"
  },
  "devDependencies": {
    "chai": "^4.3.8",
    "eslint": "^8.49.0",
    "mocha": "^10.2.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.2.2",
    "sinon": "^15.2.0",
    "supertest": "^6.4.4"
  }
}
